# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:4200

# MongoDB Configuration
# Replace with your MongoDB Atlas or local MongoDB connection string
# Example: mongodb+srv://anjali1033:<db_password>@cluster0.fpasqdb.mongodb.net/provex?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/provex?retryWrites=true&w=majority

# SMTP / Nodemailer Configuration
# Standard ports: 587 (TLS/STARTTLS, secure=false), 465 (SSL, secure=true)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@provexinds.com
ADMIN_EMAIL=admin@provexinds.com
